# ===== PostgreSQL（docker-compose 默认账号密码）=====
POSTGRES_DSN=postgresql://postgres:postgres@localhost:5432/kb_agent

# ===== LLM：DeepSeek（OpenAI 兼容接口）=====
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
MODEL_BASE_URL=https://api.deepseek.com
TEXT_MODEL_NAME=deepseek-chat

# ===== 嵌入后端 =====
# local：本地 fastembed + BGE 模型（离线、零成本、默认）
# openai：任意 OpenAI 兼容嵌入 API
EMBEDDING_BACKEND=local
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=

# ===== 检索 =====
# 语义/关键词权重：0.7 = 70% 语义 + 30% 关键词
SEMANTIC_WEIGHT=0.7

# ===== 特性开关 =====
# true 时 Agent 通过 MCP server 加载工具（默认 false 直接用工具）
FEATURE_FLAG_MCPSERVER_ENABLED=false

# ===== （可选）LangSmith 追踪 =====
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=your_key
# LANGSMITH_PROJECT=kb-agent
